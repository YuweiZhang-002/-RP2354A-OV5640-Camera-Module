; ──────────────────────────────────────────────────────────────────────────
; pio0 SM1 — VSYNC 脉宽鉴别器
;
; 目的：只有"高电平连续保持超过额定时间"的 VSYNC 脉冲才被认定为真帧边界。
;
; 实测依据 (docs/2026-08-11_22-21-22.bin, 100 MSa/s)：
;   真 VSYNC 高电平 = 260.33 us，周期 66.645 ms，1 秒内恰好 15 个
;   上电毛刺        = 10 ns  @985.651ms / 986.877ms
;   稳态毛刺        = 10 ns  @3345.066ms   ← 不只上电阶段会出现
;   上电超宽脉冲    = 1033.53 us @1002.363ms
;
; 为什么必须放在 PIO 里：
;   SM0 的丢帧序列用 `wait 1 gpio VSYNC` / `wait 0 gpio VSYNC` 数帧，
;   PIO 以系统时钟采样，10 ns 毛刺足以满足一对 wait ——
;   于是"丢三帧"可能在几微秒内跑完，采集从帧中间开始。
;   CPU 侧再怎么判定也管不到 SM0 内部的 wait，所以判定必须在 PIO 内完成。
;
; 判定方式：检测到高电平后，连续采样 32x32 次确认它一直是高；
;   任何一次采样为低就认定是毛刺并重新等待。确认窗口：
;     外层循环体 = set x(1) + 32 x [jmp pin(1) + jmp x--(1)] + jmp y--(1) = 66 周期
;     总计 32 x 66 = 2112 个 SM1 周期
;   SM1 clkdiv = 4 → 36 MHz → 2112 / 36MHz = 58.7 us
;     对真沿 260.33 us  有 4.4 倍余量
;     对 10 ns 毛刺     第一次采样就被拒
;     对 FPGA 包宽 10.67 us（GPIO9 耦合的最坏情况）也被拒
;   要调整额定值只改 CAM_VSYNC_GATE_CLKDIV。
;
; 确认通过后等待下降沿，然后：
;   irq 4 → 给 SM0 的丢帧序列（wait 1 irq 4 会自动清标志）
;   irq 0 → 路由到 PIO0_IRQ_0，供 CPU 做帧边界记账（只统计合格的 VSYNC）
; ──────────────────────────────────────────────────────────────────────────

.program vsync_gate

.define VSYNC 10

vg_wait_high:
    wait 1 gpio VSYNC           ; 候选上升沿
    set  y, 31
vg_outer:
    set  x, 31
vg_inner:
    jmp  pin, vg_still_high      ; jmp_pin = VSYNC
    jmp  vg_wait_high            ; 中途变低 → 毛刺，重新等
vg_still_high:
    jmp  x--, vg_inner
    jmp  y--, vg_outer
    ; 到这里已确认 VSYNC 连续高 2112 个 SM1 周期
    wait 0 gpio VSYNC            ; 真帧边界（下降沿）
    irq  4                       ; 给 SM0：一个合格帧边界
    irq  0                       ; 给 CPU：帧边界记账
    jmp  vg_wait_high


; ──────────────────────────────────────────────────────────────────────────
; pio0 SM0 — 摄像头采集（沿用 8 月 5 日机制）
;
;   1. 等 4 个"合格"VSYNC 边界（原来是 4 对 wait 1/wait 0 gpio VSYNC）
;      —— 唯一的改动就在这里：边界由 SM1 鉴别后经 IRQ4 送达，
;         10 ns 毛刺再也不可能凑数。
;   2. 进入 wrap 后不再读取 VSYNC，只由 HREF/PCLK 连续驱动，
;      行长度由 HREF 电平决定（jmp pin, HREF），与 8 月 5 日完全一致。
; ──────────────────────────────────────────────────────────────────────────

.program cam_capture

.define PCLK  11
.define HREF  20

    ; 对齐第一帧起点，但不采集这一帧。
    wait 1 irq 4

    ; 等待第一帧结束，在第二帧起点开始连续采集。
    wait 1 irq 4

    ; 等待第二帧结束，在第三帧起点开始连续采集。
    wait 1 irq 4

    ; 等待第三帧结束，在第四帧起点开始连续采集。
    wait 1 irq 4

.wrap_target
line_loop:
    wait 1 gpio HREF

byte_loop:
    wait 1 gpio PCLK
    in pins, 8
    wait 0 gpio PCLK
    jmp pin, byte_loop
    jmp line_loop
.wrap


% c-sdk {
#include "cam_pio.h"

/*
 * SM1 时钟分频。额定阈值 = 2112 / (clk_sys / CAM_VSYNC_GATE_CLKDIV)
 *   clk_sys = 144 MHz, clkdiv = 4 → 36 MHz → 58.7 us
 * 增大该值即提高额定脉宽要求；必须保持远小于真实 VSYNC 高电平宽度
 * （HTS=1562 时为 260.33 us；HTS=1464 时为 244 us）。
 */
#define CAM_VSYNC_GATE_CLKDIV 4.0f

static inline void cam_capture_program_init(PIO pio, uint sm, uint offset)
{
    pio_sm_config c = cam_capture_program_get_default_config(offset);

    sm_config_set_in_pins(&c, CAM_DATA_PIN_BASE);
    sm_config_set_jmp_pin(&c, CAM_HREF_PIN);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_in_shift(&c, false, true, 8);

    pio_sm_init(pio, sm, offset, &c);
}

static inline void vsync_gate_program_init(PIO pio, uint sm, uint offset)
{
    pio_sm_config c = vsync_gate_program_get_default_config(offset);

    /* 该状态机只读 VSYNC，且只通过 jmp pin 读取，不需要 in/out 引脚。 */
    sm_config_set_jmp_pin(&c, CAM_VSYNC_PIN);
    sm_config_set_clkdiv(&c, CAM_VSYNC_GATE_CLKDIV);

    pio_sm_init(pio, sm, offset, &c);
}
%}
