.program cam_capture

.define PCLK  11
.define HREF  20
.define VSYNC 10

; ──────────────────────────────────────────────────────────────────────────
; 摄像头采集程序 - 启动时跳过第一帧，运行期纯HREF/PCLK驱动
;
; 工作流程：
;   1. 第一组VSYNC等待对齐第一帧起点，该帧用于传感器稳定且不采样
;   2. 第二组VSYNC等待第一帧结束，并在第二帧起点进入采集循环
;   3. 等待HREF拉高并按PCLK采集一行
;   4. HREF拉低后返回行外层，等待下一行
;   5. 两组等待都位于wrap_target之前，只在启动/重启时执行一次
; ──────────────────────────────────────────────────────────────────────────

    ; 对齐第一帧起点，但不采集这一帧。
    wait 1 gpio VSYNC
    wait 0 gpio VSYNC

    ; 等待第一帧结束，在第二帧起点开始连续采集。
    wait 1 gpio VSYNC
    wait 0 gpio VSYNC

    ; 等待第二帧结束，在第三帧起点开始连续采集。
    wait 1 gpio VSYNC
    wait 0 gpio VSYNC

    ; 等待第三帧结束，在第四帧起点开始连续采集。
    wait 1 gpio VSYNC
    wait 0 gpio VSYNC

.wrap_target
line_loop:
    wait 1 gpio HREF

byte_loop:
    wait 1 gpio PCLK
    in pins, 8
    wait 0 gpio PCLK
    jmp pin, byte_loop
    jmp line_loop
.wrap


% c-sdk {
#include "cam_pio.h"

static inline void cam_capture_program_init(PIO pio, uint sm, uint offset)
{
    pio_sm_config c = cam_capture_program_get_default_config(offset);

    sm_config_set_in_pins(&c, CAM_DATA_PIN_BASE);
    sm_config_set_jmp_pin(&c, CAM_HREF_PIN);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_in_shift(&c, false, true, 8);

    pio_sm_init(pio, sm, offset, &c);
}
%}
