.program cam_capture

.define PCLK  11
.define HREF  20

; ──────────────────────────────────────────────────────────────────────────
; 摄像头采集程序 - 纯边沿驱动
;
; 工作流程：
;   1. 等待 HREF 拉高（行有效）
;   2. 等待 PCLK 上升沿
;   3. 读取 8-bit 数据到 ISR
;   4. 等待 PCLK 下降沿
;   5. 如果 HREF 仍为高电平，继续下一字节
;   6. 如果 HREF 已低电平，回到顶部等下一行
; ──────────────────────────────────────────────────────────────────────────

.wrap_target
line_loop:
    wait 1 gpio HREF

byte_loop:
    wait 1 gpio PCLK
    in pins, 8
    wait 0 gpio PCLK
    jmp pin, byte_loop
    jmp line_loop
.wrap


% c-sdk {
#include "cam_pio.h"

static inline void cam_capture_program_init(PIO pio, uint sm, uint offset)
{
    pio_sm_config c = cam_capture_program_get_default_config(offset);

    sm_config_set_in_pins(&c, CAM_DATA_PIN_BASE);
    sm_config_set_jmp_pin(&c, CAM_HREF_PIN);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_in_shift(&c, false, true, 8);

    pio_sm_init(pio, sm, offset, &c);
}
%}
