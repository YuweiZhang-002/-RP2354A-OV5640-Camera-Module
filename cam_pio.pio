.program cam_capture

.define PCLK  11
.define HREF  20
.define VSYNC 10

; ──────────────────────────────────────────────────────────────────────────
; 摄像头采集程序 —— 每条 HREF 恒定产出 640 字节，PIO 不触碰 VSYNC
;
;   1. irq wait 0  通知CPU：状态机停在确定入口，DMA可以先arm
;   2. CPU清IRQ0后进入行循环，此后PIO永不等待CPU
;   3. 每行：wait 0 HREF -> wait 1 HREF -> 输出恰好 640 字节
;        HREF 仍为高  -> 按 PCLK 采一个真实像素
;        HREF 已结束  -> 置 IRQ1 并补一个 0 字节
;
; 核心不变量（无条件成立，与行长度无关）：
;     一个 HREF  <=>  恰好 640 个字节  <=>  恰好一次 640-byte DMA 完成
;
; 为什么必须补零而不是"HREF高就采"：
;   实测 docs/2026-08-11_22-21-22.bin，上电 805.4~991.5ms 之间有 176 条
;   异常行（0 / 11 / 58~92 / 171~178 / 809 / 922 个PCLK），1000ms 之后
;   23258 条行全部恰好 640 个PCLK。若按 HREF 电平决定行长，
;   一条短行会让 640-byte DMA 块边界相对 HREF 逐字节永久错位（帧撕裂）；
;   若按纯计数决定行长，一条短行会让状态机去吃下一行的 PCLK。
;   PIO 内部补零同时避免这两种失败：块边界永远对齐 HREF，
;   短行只是自己的尾部变成 0，且补零以约 35ns/字节跑完
;   （最坏 640 字节 = 22.2us，远小于 76.8us 消隐窗口），绝不会卡死。
;
; 为什么 VSYNC 完全不进 PIO：
;   `wait 1/wait 0 gpio VSYNC` 会被 10ns 毛刺满足。实测 VSYNC 在
;   985.651ms / 986.877ms / 3345.066ms 出现 3 个 10ns 脉冲，
;   1002.363ms 出现 1 个 1033.53us 超宽脉冲（真值恒为 260.33us）。
;   帧边界由 CPU 中断处理，只用"高电平宽度 >= 20us"挡掉 10ns 级毛刺，
;   见 cam_pio.c 的 cam_gpio_irq_callback()。
;
; 行尾不使用 `irq wait`：CPU中断延迟再大也不会让
; `wait 0 gpio HREF` 吞掉一条已经开始的物理行。
; ──────────────────────────────────────────────────────────────────────────

    ; DMA必须先arm。CPU清除IRQ0之前，PIO不会读取任何摄像头电平。
    irq wait 0

.wrap_target
line_loop:
    ; 每行都从消隐区重新对齐：先确认HREF已结束，再等待新行开始。
    wait 0 gpio HREF
    wait 1 gpio HREF

    ; 外层20次 x 内层32次 = 640字节，与DVPHO=640严格一致。
    set y, 19
outer_loop:
    set x, 31
byte_loop:
    ; jmp_pin = HREF。仍为高 -> 真实像素；已结束 -> 补零。
    jmp pin, take_byte

    ; 本行发生了补零：置PIO IRQ1（非阻塞），CPU在该行的DMA完成中断里
    ; 读取并清除，把该行标记为 CAM_FRAME_ERR_HREF_LENGTH。
    ; 该标志只可能在本块填充期间被置位，因此与行一一对应。
    irq nowait 1
    in null, 8              ; 8个0位触发autopush，补一个0字节
    jmp next_byte

take_byte:
    wait 1 gpio PCLK
    in pins, 8
    wait 0 gpio PCLK

next_byte:
    jmp x--, byte_loop
    jmp y--, outer_loop
.wrap


% c-sdk {
#include "cam_pio.h"

static inline void cam_capture_program_init(PIO pio, uint sm, uint offset)
{
    pio_sm_config c = cam_capture_program_get_default_config(offset);

    sm_config_set_in_pins(&c, CAM_DATA_PIN_BASE);
    /* jmp pin 用来判断 HREF 是否仍然有效，决定采样还是补零。 */
    sm_config_set_jmp_pin(&c, CAM_HREF_PIN);
    sm_config_set_clkdiv(&c, 1.0f);
    sm_config_set_in_shift(&c, false, true, 8);
    /* This state machine never transmits.  Joining both FIFO halves gives DMA
     * eight bytes of RX elasticity instead of four during bus arbitration. */
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);

    pio_sm_init(pio, sm, offset, &c);
}
%}
