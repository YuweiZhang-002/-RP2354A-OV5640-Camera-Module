.program packet_tx
.side_set 1

; ──────────────────────────────────────────────────────────────────────────
; PIO1 输出桥接程序
;
; 时序目标：
;   每字节占 4 个 SM 周期 (SM 时钟 96MHz -> 字节速率 24MHz)
;   - 周期1: 输出 8-bit 数据，同时 GPIO8 保持低电平
;   - 周期2: GPIO8 拉高
;   - 周期3: 保持高电平 1 个空槽
;   - 周期4: GPIO8 拉低，为下一个字节做准备
; ──────────────────────────────────────────────────────────────────────────

.wrap_target
    out pins, 8         side 0   ; 先送数据，GPIO8 低电平保持
    nop                 side 1   ; 拉高 GPIO8
    nop                 side 1   ; 空一格，保持高电平
    nop                 side 0   ; 拉低 GPIO8，准备下一个字节
.wrap


% c-sdk {
#include "fpga_pio.h"
%}
